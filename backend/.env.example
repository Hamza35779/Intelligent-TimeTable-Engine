# Application Settings
PROJECT_NAME="Intelligent Autonomous Timetable Engine"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (PostgreSQL default, falls back to SQLite if unreachable or specified)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/timetable_db"

# Solver Configuration
DEFAULT_SOLVER_TIMEOUT_SECONDS=5
MAX_SOLVER_TIMEOUT_SECONDS=30

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
